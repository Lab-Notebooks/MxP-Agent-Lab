// What raptorize adds to a kernel. @M <name> is a decision in R/plan.md; <...> comes from app/.

// ---- <header of source> ----
// RAPTOR-BEGIN: precision modes of @M function()
enum class Precision { kFp64, k<Mode>..., kLowPrec };
void @M function At(Precision m, <params>);
// RAPTOR-END

// ---- @M source ----
#include <stdexcept>  // RAPTOR

<existing code, untouched>

// RAPTOR-BEGIN: @M function() at precision m; the @M lowprec seed is evolved.
// EVOLVE-BLOCK-START
@M lowprec <callee>LowPrec(@M lowprec ...) { <callee body in @M lowprec> }
void @M function LowPrec(<params in @M lowprec>) { <body, calling *LowPrec> }
// EVOLVE-BLOCK-END

void @M function At(Precision m, <params>) {
    if (m == Precision::kFp64) {
        @M function(<args>);
    } else if (m == Precision::kLowPrec) {
        <args to @M lowprec>; @M function LowPrec(<low args>); <results back to fp64>;
#ifdef BUBBLE_RAPTOR
    } else if (m == Precision::k<Mode>) {  // one branch per entry of @M formats
        __raptor_truncate_op_func(@M function, 64, 1, <exponent>, <mantissa>)(<args>);
#endif
    } else {
        throw std::invalid_argument("this precision needs a RAPTOR=1 build");
    }
}
// RAPTOR-END

// ---- <call site> ----
@M function At(mode, <args>);  // RAPTOR: was @M function(<args>);

// ---- <step> ----
// RAPTOR-BEGIN: fp64 shadow, same dt
<shadow state> = <state>; @M function(<shadow args>);
<append error(<state>, <shadow state>) as @M errors>;
// RAPTOR-END
