 // kernel.cpp -- the hot kernel, FP64.
 #include "kernel.h"
 
+// RAPTOR-BEGIN: RAPTOR runtime header.
+#ifdef BUBBLE_RAPTOR
+#include "raptor/raptor.h"
+#endif
+// RAPTOR-END
+
 double kernelPoint(double a, double b, double c) {
     const double d1 = b - a;
     const double d2 = c - b;
@@ -12,3 +18,50 @@ void applyKernel(const std::vector<double>& in, std::vector<double>& out) {
         out[i] += kernelPoint(in[i - 1], in[i], in[i + 1]);
     }
 }
+
+// RAPTOR-BEGIN: applyKernel() at precision m; the float seed is evolved.
+// EVOLVE-BLOCK-START
+float kernelPointLowPrec(float a, float b, float c) {
+    const float d1 = b - a;
+    const float d2 = c - b;
+    return (d1 * d1 + d2 * d2) / (1.0e-12f + d1 * d1 + d2 * d2) * (c - a) * 0.5f;
+}
+
+void applyKernelLowPrec(const std::vector<float>& in, std::vector<float>& out) {
+    for (std::size_t i = 1; i + 1 < in.size(); ++i) {
+        out[i] += kernelPointLowPrec(in[i - 1], in[i], in[i + 1]);
+    }
+}
+// EVOLVE-BLOCK-END
+
+// fp64 <-> float boundary: uses double, so no "LowPrec" in its name.
+static void applyKernelViaFloat(const std::vector<double>& in, std::vector<double>& out) {
+    std::vector<float> inF(in.begin(), in.end()), outF(in.size(), 0.0f);
+    applyKernelLowPrec(inF, outF);
+    for (std::size_t i = 0; i < out.size(); ++i) out[i] += outF[i];
+}
+
+#ifdef BUBBLE_RAPTOR
+// applyKernel() and its callees in this file, FP ops truncated to (exponent, mantissa) bits.
+using ApplyFn = void (*)(const std::vector<double>&, std::vector<double>&);
+static ApplyFn applyKernelTruncated(Precision m) {
+    static ApplyFn fp32 = __raptor_truncate_op_func(applyKernel, 64, 1, 8, 23);
+    static ApplyFn bf16 = __raptor_truncate_op_func(applyKernel, 64, 1, 8, 7);
+    return m == Precision::kFp32 ? fp32 : bf16;
+}
+#endif
+
+#ifdef BUBBLE_RAPTOR
+bool precisionAvailable(Precision) { return true; }
+#else
+bool precisionAvailable(Precision m) { return m == Precision::kFp64 || m == Precision::kLowPrec; }
+#endif
+
+void applyKernelAt(Precision m, const std::vector<double>& in, std::vector<double>& out) {
+    if (m == Precision::kFp64) applyKernel(in, out);
+    else if (m == Precision::kLowPrec) applyKernelViaFloat(in, out);
+#ifdef BUBBLE_RAPTOR
+    else applyKernelTruncated(m)(in, out);
+#endif
+}
+// RAPTOR-END
