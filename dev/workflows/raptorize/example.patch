diff --git a/src/params.h b/src/params.h
index cac72f5..0102d47 100644
--- a/src/params.h
+++ b/src/params.h
@@ -2,15 +2,41 @@
 #pragma once
 #include <string>
 
+// Precision of the hot kernel; everything else stays FP64.  Any mode but fp64
+// also advances an FP64 shadow copy of the state, so one run is the comparison.
+//   fp64                    reference kernel, no shadow
+//   fp32, tf32, bf16, fp16  the FP64 kernel with every op truncated by RAPTOR
+enum class Precision { kFp64, kFp32, kTf32, kBf16, kFp16 };
+
+inline const char* precisionName(Precision m) {
+    switch (m) {
+        case Precision::kFp32: return "fp32";
+        case Precision::kTf32: return "tf32";
+        case Precision::kBf16: return "bf16";
+        case Precision::kFp16: return "fp16";
+        default: return "fp64";
+    }
+}
+
 struct Params {
     int nx = 128;
     double tmax = 1.0;
+    Precision precision = Precision::kFp64;
     std::string outdir = "out";
 };
 
+inline bool toPrecision(const std::string& v, Precision& out) {
+    for (Precision m : {Precision::kFp64, Precision::kFp32, Precision::kTf32, Precision::kBf16,
+                        Precision::kFp16}) {
+        if (v == precisionName(m)) { out = m; return true; }
+    }
+    return false;
+}
+
 inline bool setParam(const std::string& key, const std::string& val, Params& p) {
     if (key == "nx") p.nx = std::stoi(val);
     else if (key == "tmax") p.tmax = std::stod(val);
+    else if (key == "precision") return toPrecision(val, p.precision);
     else if (key == "outdir") p.outdir = val;
     else return false;
     return true;
