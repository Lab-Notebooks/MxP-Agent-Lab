@@ -1,5 +1,6 @@
 // driver.cpp -- one forward-Euler step.
 #include <algorithm>
+#include <cmath>  // RAPTOR: errL2()
 #include <vector>
 
 #include "driver.h"
@@ -7,7 +8,27 @@
 
 void step(const Params& p, std::vector<double>& u, std::vector<double>& rhs, double dt) {
     std::fill(rhs.begin(), rhs.end(), 0.0);
-    applyKernel(u, rhs);
+    applyKernelAt(p.precision, u, rhs);  // RAPTOR: was applyKernel(u, rhs);
     for (std::size_t i = 0; i < u.size(); ++i) u[i] += dt * rhs[i];
     (void)p;
 }
+
+// RAPTOR-BEGIN: FP64 shadow, advanced by the unchanged step().
+void stepWithShadow(const Params& p, std::vector<double>& u, std::vector<double>& uRef,
+                    std::vector<double>& rhs, double dt) {
+    step(p, u, rhs, dt);
+    if (p.precision == Precision::kFp64) {
+        uRef = u;
+        return;
+    }
+    Params pRef = p;
+    pRef.precision = Precision::kFp64;
+    step(pRef, uRef, rhs, dt);
+}
+
+double errL2(const std::vector<double>& u, const std::vector<double>& uRef) {
+    double s = 0.0;
+    for (std::size_t i = 0; i < u.size(); ++i) s += (u[i] - uRef[i]) * (u[i] - uRef[i]);
+    return std::sqrt(s / static_cast<double>(u.size()));
+}
+// RAPTOR-END
