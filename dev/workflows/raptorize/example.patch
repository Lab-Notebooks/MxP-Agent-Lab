 #pragma once
 #include <string>
 
+// RAPTOR-BEGIN: kernel precision: fp64 original, fp32/bf16 RAPTOR, lowprec float seed.
+enum class Precision { kFp64, kFp32, kBf16, kLowPrec };
+
+inline bool toPrecision(const std::string& v, Precision& out) {
+    const char* names[] = {"fp64", "fp32", "bf16", "lowprec"};
+    for (int i = 0; i < 4; ++i) {
+        if (v == names[i]) { out = static_cast<Precision>(i); return true; }
+    }
+    return false;
+}
+// RAPTOR-END
+
 struct Params {
     int nx = 128;
     int steps = 100;
+    Precision precision = Precision::kFp64;  // RAPTOR
     std::string outdir = "out";
 };
 
 inline bool setParam(const std::string& key, const std::string& val, Params& p) {
     if (key == "nx") p.nx = std::stoi(val);
     else if (key == "steps") p.steps = std::stoi(val);
+    else if (key == "precision") return toPrecision(val, p.precision);  // RAPTOR
     else if (key == "outdir") p.outdir = val;
     else return false;
     return true;
