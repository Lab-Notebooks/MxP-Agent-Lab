 }
 
+// Seed: a straight float transcription of kernelPoint() / applyKernel().
+// EVOLVE-BLOCK-START
+float kernelPointLowPrec(float a, float b, float c) {
+    const float d1 = b - a;
+    const float d2 = c - b;
+    return (d1 * d1 + d2 * d2) / (1.0e-12f + d1 * d1 + d2 * d2) * (c - a) * 0.5f;
+}
+
+void applyKernelLowPrec(const std::vector<float>& in, std::vector<float>& out) {
+    for (std::size_t i = 1; i + 1 < in.size(); ++i) {
+        out[i] += kernelPointLowPrec(in[i - 1], in[i], in[i + 1]);
+    }
+}
+// EVOLVE-BLOCK-END
+
 namespace {
 
+// Fixed fp64 <-> float boundary (outside the block, counted in the kernel time).
+void applyKernelViaLowPrec(const std::vector<double>& in, std::vector<double>& out) {
+    static std::vector<float> inF, outF;
+    inF.assign(in.begin(), in.end());
+    outF.assign(in.size(), 0.0f);
+    applyKernelLowPrec(inF, outF);
+    for (std::size_t i = 0; i < out.size(); ++i) out[i] += static_cast<double>(outF[i]);
+}
