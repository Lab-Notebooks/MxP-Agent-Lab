+// RAPTOR-BEGIN: errors vs the fp64 shadow
+void errorsVsShadow(const Grid& g, const std::vector<double>& dfun,
+                    const std::vector<double>& shadow, Diagnostics& d) {
+    double local[2] = {0.0, 0.0};  // sum of squares, max
+    for (int j = 0; j < g.ny(); ++j) {
+        for (int i = 0; i < g.nx(); ++i) {
+            const double e = std::fabs(dfun[g.index(i, j)] - shadow[g.index(i, j)]);
+            local[0] += e * e;
+            if (e > local[1]) local[1] = e;
+        }
+    }
+    double sum = 0.0;
+    MPI_Allreduce(&local[0], &sum, 1, MPI_DOUBLE, MPI_SUM, g.comm());
+    MPI_Allreduce(&local[1], &d.err_max, 1, MPI_DOUBLE, MPI_MAX, g.comm());
+    d.err_rms = std::sqrt(sum / (double(g.nxGlobal()) * g.nyGlobal()));
+}
+// RAPTOR-END
