+// RAPTOR-BEGIN: advectWeno at precision m; optimize evolves the lowprec seed.
+// EVOLVE-BLOCK-START
+// The seed: advectWeno and its FP callees, copied in float and renamed *LowPrec.
+namespace {
+
+inline float sqrLowPrec(float x) { return x * x; }
+
+float wenoFaceValueLowPrec(float s1, float s2, float s3, float s4, float s5, bool positive) {
+    const float kEpsLowPrec = 1.0e-15f;
+    const float rIS1 = (13.0f / 12.0f) * sqrLowPrec(s1 - 2.0f * s2 + s3) +
+                       (1.0f / 4.0f) * sqrLowPrec(s1 - 4.0f * s2 + 3.0f * s3);
+    const float rIS2 = (13.0f / 12.0f) * sqrLowPrec(s2 - 2.0f * s3 + s4) +
+                       (1.0f / 4.0f) * sqrLowPrec(s2 - s4);
+    const float rIS3 = (13.0f / 12.0f) * sqrLowPrec(s3 - 2.0f * s4 + s5) +
+                       (1.0f / 4.0f) * sqrLowPrec(3.0f * s3 - 4.0f * s4 + s5);
+
+    const float d1 = positive ? (1.0f / 10.0f) : (3.0f / 10.0f);
+    const float d2 = 6.0f / 10.0f;
+    const float d3 = positive ? (3.0f / 10.0f) : (1.0f / 10.0f);
+
+    const float aT1 = d1 / sqrLowPrec(kEpsLowPrec + rIS1);
+    const float aT2 = d2 / sqrLowPrec(kEpsLowPrec + rIS2);
+    const float aT3 = d3 / sqrLowPrec(kEpsLowPrec + rIS3);
+
+    const float aSum = aT1 + aT2 + aT3;
+    const float a1 = aT1 / aSum;
+    const float a2 = aT2 / aSum;
+    const float a3 = aT3 / aSum;
+
+    float fT1;
+    float fT2;
+    float fT3;
+    if (positive) {
+        fT1 = (2.0f / 6.0f) * s1 - (7.0f / 6.0f) * s2 + (11.0f / 6.0f) * s3;
+        fT2 = -(1.0f / 6.0f) * s2 + (5.0f / 6.0f) * s3 + (2.0f / 6.0f) * s4;
+        fT3 = (2.0f / 6.0f) * s3 + (5.0f / 6.0f) * s4 - (1.0f / 6.0f) * s5;
+    } else {
+        fT1 = -(1.0f / 6.0f) * s1 + (5.0f / 6.0f) * s2 + (2.0f / 6.0f) * s3;
+        fT2 = (2.0f / 6.0f) * s2 + (5.0f / 6.0f) * s3 - (1.0f / 6.0f) * s4;
+        fT3 = (11.0f / 6.0f) * s3 - (7.0f / 6.0f) * s4 + (2.0f / 6.0f) * s5;
+    }
+
+    return a1 * fT1 + a2 * fT2 + a3 * fT3;
+}
+
+}  // namespace
+
+void advectWenoLowPrec(const Grid& g, float dxi, float dyi, const float* phi, const float* u,
+                       const float* v, float* rhs) {
+    const int nx = g.nx();
+    const int ny = g.ny();
+
+    for (int j = 0; j < ny; ++j) {
+        for (int i = 0; i < nx; ++i) {
+            const float ul = u[g.index(i, j)];
+            const float ur = u[g.index(i + 1, j)];
+            const float vl = v[g.index(i, j)];
+            const float vr = v[g.index(i, j + 1)];
+
+            float flx;
+            float frx;
+            if (ur > 0.0f) {
+                frx = wenoFaceValueLowPrec(phi[g.index(i - 2, j)], phi[g.index(i - 1, j)],
+                                           phi[g.index(i, j)], phi[g.index(i + 1, j)],
+                                           phi[g.index(i + 2, j)], true);
+            } else {
+                frx = wenoFaceValueLowPrec(phi[g.index(i - 1, j)], phi[g.index(i, j)],
+                                           phi[g.index(i + 1, j)], phi[g.index(i + 2, j)],
+                                           phi[g.index(i + 3, j)], false);
+            }
+            if (ul > 0.0f) {
+                flx = wenoFaceValueLowPrec(phi[g.index(i - 3, j)], phi[g.index(i - 2, j)],
+                                           phi[g.index(i - 1, j)], phi[g.index(i, j)],
+                                           phi[g.index(i + 1, j)], true);
+            } else {
+                flx = wenoFaceValueLowPrec(phi[g.index(i - 2, j)], phi[g.index(i - 1, j)],
+                                           phi[g.index(i, j)], phi[g.index(i + 1, j)],
+                                           phi[g.index(i + 2, j)], false);
+            }
+
+            float fly;
+            float fry;
+            if (vr > 0.0f) {
+                fry = wenoFaceValueLowPrec(phi[g.index(i, j - 2)], phi[g.index(i, j - 1)],
+                                           phi[g.index(i, j)], phi[g.index(i, j + 1)],
+                                           phi[g.index(i, j + 2)], true);
+            } else {
+                fry = wenoFaceValueLowPrec(phi[g.index(i, j - 1)], phi[g.index(i, j)],
+                                           phi[g.index(i, j + 1)], phi[g.index(i, j + 2)],
+                                           phi[g.index(i, j + 3)], false);
+            }
+            if (vl > 0.0f) {
+                fly = wenoFaceValueLowPrec(phi[g.index(i, j - 3)], phi[g.index(i, j - 2)],
+                                           phi[g.index(i, j - 1)], phi[g.index(i, j)],
+                                           phi[g.index(i, j + 1)], true);
+            } else {
+                fly = wenoFaceValueLowPrec(phi[g.index(i, j - 2)], phi[g.index(i, j - 1)],
+                                           phi[g.index(i, j)], phi[g.index(i, j + 1)],
+                                           phi[g.index(i, j + 2)], false);
+            }
+
+            rhs[g.index(i, j)] += -(frx * ur - flx * ul) * dxi - (fry * vr - fly * vl) * dyi;
+        }
+    }
+}
+// EVOLVE-BLOCK-END
+
+void advectWenoAt(Precision m, const Grid& g, const std::vector<double>& phi,
+                  const std::vector<double>& u, const std::vector<double>& v,
+                  std::vector<double>& rhs) {
+    if (m == Precision::kFp64) {
+        advectWeno(g, phi, u, v, rhs);
+    } else if (m == Precision::kLowPrec) {
+        // fp64 -> float, run the seed, float -> fp64.
+        if (rhs.size() != g.size()) rhs.assign(g.size(), 0.0);
+        std::vector<float> phif(phi.begin(), phi.end()), uf(u.begin(), u.end()),
+            vf(v.begin(), v.end()), rhsf(rhs.begin(), rhs.end());
+        advectWenoLowPrec(g, float(1.0 / g.dx()), float(1.0 / g.dy()), phif.data(), uf.data(),
+                          vf.data(), rhsf.data());
+        std::copy(rhsf.begin(), rhsf.end(), rhs.begin());
+#ifdef BUBBLE_RAPTOR
+    } else if (m == Precision::kFp32) {
+        // Arguments: function, from fp64, to MPFR (1), exponent bits, mantissa bits.
+        // Truncates advectWeno and its callees in this file; other files stay fp64.
+        __raptor_truncate_op_func(advectWeno, 64, 1, 8, 23)(g, phi, u, v, rhs);
+    } else if (m == Precision::kBf16) {
+        __raptor_truncate_op_func(advectWeno, 64, 1, 8, 7)(g, phi, u, v, rhs);
+#endif
+    } else {
+        throw std::invalid_argument("this precision needs a RAPTOR=1 build");
+    }
+}
+// RAPTOR-END
